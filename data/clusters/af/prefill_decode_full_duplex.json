{
    "num_workers": 6,
    "networks": {
        "af_net": "af-network-profile"
    },
    "worker_groups": [
        {
            "name": "attention-pool",
            "capabilities": ["af_attention"],
            "hardware": "attention-device",
            "num_workers": 4,
            "network": "af_net"
        },
        {
            "name": "ffn-pool",
            "capabilities": ["af_ffn"],
            "hardware": "ffn-device",
            "num_workers": 2,
            "network": "af_net"
        }
    ],
    "af": {
        "enabled": true,
        "phases": ["prefill", "decode"],
        "af_block_size": 4,
        "trace_enabled": true,
        "weight_dtype": "bf16",
        "activation_dtype": "bf16",
        "kv_cache_dtype": "bf16",
        "communication_fabrics": [
            {
                "resource_group": "af-fabric",
                "network": "af_net",
                "duplex": "full",
                "lanes": [
                    {"name": "a_to_f", "capacity": 1},
                    {"name": "f_to_a", "capacity": 1}
                ]
            }
        ],
        "links": [
            {
                "name": "attention-ffn",
                "phases": ["prefill", "decode"],
                "attention_group": "attention-pool",
                "ffn_group": "ffn-pool",
                "resource_group": "af-fabric",
                "a_to_f_dtype": "bf16",
                "f_to_a_dtype": "bf16"
            }
        ]
    }
}
