{
    "num_workers": 5,
    "networks": {
        "af_net": "af-network-profile"
    },
    "worker_groups": [
        {
            "name": "prefill-pool",
            "role": "prefill",
            "hardware": "prefill-device",
            "num_workers": 1,
            "network": "af_net"
        },
        {
            "name": "decode-attention-pool",
            "capabilities": ["af_attention"],
            "hardware": "attention-device",
            "num_workers": 2,
            "network": "af_net"
        },
        {
            "name": "decode-ffn-pool",
            "capabilities": ["af_ffn"],
            "hardware": "ffn-device",
            "num_workers": 2,
            "network": "af_net"
        }
    ],
    "af": {
        "enabled": true,
        "phases": ["decode"],
        "af_block_size": 2,
        "trace_enabled": true,
        "weight_dtype": "bf16",
        "activation_dtype": "bf16",
        "kv_cache_dtype": "bf16",
        "communication_fabrics": [
            {
                "resource_group": "shared-af-fabric",
                "network": "af_net",
                "duplex": "half",
                "lanes": [
                    {"name": "shared", "capacity": 1}
                ]
            }
        ],
        "links": [
            {
                "name": "decode-attention-ffn",
                "phases": ["decode"],
                "attention_group": "decode-attention-pool",
                "ffn_group": "decode-ffn-pool",
                "resource_group": "shared-af-fabric",
                "a_to_f_dtype": "bf16",
                "f_to_a_dtype": "bf16"
            }
        ]
    }
}
