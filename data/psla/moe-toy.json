{
    "name": "moe-toy",
    "model": "MoE-Toy",
    "qps": 10,
    "distribution": "burst",
    "prefill_mean_len": 32,
    "prefill_range_len": 0,
    "decode_mean_len": 4,
    "decode_range_len": 0,
    "decode_len_distribution": "uniform",
    "first_token_latency": {
        "max": 10,
        "p50": 2,
        "p99": 3
    },
    "decode_token_latency": {
        "p50": 0.02,
        "p99": 0.05,
        "max": 1
    },
    "is_moe_model": true,
    "num_experts": 4,
    "num_experts_per_tok": 2,
    "moe_intermediate_size": 64,
    "num_shared_experts": 1,
    "num_moe_layers": 2,
    "first_k_dense_replace": 1,
    "moe_layer_freq": 1,
    "interleave_moe_layer_step": 1,
    "hidden_size": 128,
    "intermediate_size": 256,
    "num_attention_heads": 8,
    "num_key_value_heads": 8
}
